NODE_ENV=test
PORT=4001

DATABASE_URL=postgresql://myday:myday@localhost:5433/myday_test?schema=public

JWT_ACCESS_SECRET=test-access-secret-please-32-characters-min
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=myday_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

CORS_ALLOWED_ORIGINS=http://localhost:3000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Fixture-only signing keys (not real Upstash secrets) so QStash signature verification is
# testable without depending on the real account's keys.
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=test-current-signing-key-fixture
QSTASH_NEXT_SIGNING_KEY=test-next-signing-key-fixture
API_BASE_URL=http://localhost:4001/api/v1

RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=10000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10000

LOG_LEVEL=silent

RETENTION_AUDIT_LOG_DAYS=365
RETENTION_NOTIFICATION_JOB_DAYS=90
RETENTION_EXPIRED_SESSION_DAYS=30
RETENTION_EXPIRED_RESET_TOKEN_DAYS=7
