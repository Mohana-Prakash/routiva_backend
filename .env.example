# Runtime
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://myday:myday@localhost:5432/myday_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-please-32-chars-min
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=myday_refresh
REFRESH_COOKIE_DOMAIN=localhost
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# CORS - comma separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web Push (VAPID) - generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Rate limiting
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# Logging
LOG_LEVEL=info

# Data retention (days)
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_NOTIFICATION_JOB_DAYS=90
RETENTION_EXPIRED_SESSION_DAYS=30
RETENTION_EXPIRED_RESET_TOKEN_DAYS=7
